model Transaction {
  id                         Int                 @id @default(autoincrement())
  amount                     Decimal             @db.Decimal(14, 2)
  currency                   String
  payee                      String
  paymentMode                PaymentMode
  status                     PaymentStatus       @default(PENDING)
  description                String?
  date                       DateTime
  expenseId                  Int?                @map("expense_id")
  proofFileId                Int?                @unique @map("proof_file_id")
  bankAccountId              Int?                @map("bank_account_id")
  cashAccountId              Int?                @map("cash_account_id")
  mobileAccountId            Int?                @map("mobile_account_id")
  otherAccountId             Int?                @map("other_account_id")
  checkoutRequestId          String?             @unique
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  expense                    OperationalExpense? @relation(fields: [expenseId], references: [id])
  proofFile                  ProofFile?          @relation(fields: [proofFileId], references: [id], name: "TransactionProofFile")
  bankAccount                BankAccount?        @relation(fields: [bankAccountId], references: [id], name: "BankAccountTransactions")
  cashAccount                CashAccount?        @relation(fields: [cashAccountId], references: [id], name: "CashAccountTransactions")
  mobileAccount              MobileAccount?      @relation(fields: [mobileAccountId], references: [id], name: "MobileAccountTransactions")
  otherAccount               OtherAccount?       @relation(fields: [otherAccountId], references: [id], name: "OtherAccountTransactions")
  createdByAdminCognitoId    String?
  createdByAccountsCognitoId String?
  createdByAdmin             Admin?              @relation(fields: [createdByAdminCognitoId], references: [cognitoId], name: "AdminTransactionsCreated", onDelete: SetNull)
  createdByAccounts          Accounts?           @relation(fields: [createdByAccountsCognitoId], references: [cognitoId], name: "AccountsTransactionsCreated", onDelete: SetNull)

  @@index([expenseId])
  @@index([proofFileId])
  @@index([bankAccountId])
  @@index([cashAccountId])
  @@index([mobileAccountId])
  @@index([otherAccountId])
  @@index([createdByAdminCognitoId])
  @@index([createdByAccountsCognitoId])
}

model ProofFile {
  id                          Int          @id @default(autoincrement())
  expenseType                 ExpenseType?
  clientExpenseId             Int?
  operationalExpenseId        Int?
  quotationId                 Int?
  s3Key                       String       @unique
  url                         String
  uploadedByUserCognitoId     String?
  uploadedByAdminCognitoId    String?
  uploadedByAccountsCognitoId String?
  uploadedByStaffCognitoId    String?
  createdAt                   DateTime     @default(now())

  clientExpense      ClientExpense?      @relation(fields: [clientExpenseId], references: [id], name: "ClientExpenseProofFiles")
  operationalExpense OperationalExpense? @relation(fields: [operationalExpenseId], references: [id], name: "OperationalExpenseProofFiles")
  quotation          Quotation?          @relation(fields: [quotationId], references: [id], name: "QuotationProofFiles")

  uploadedByUser     User?     @relation(fields: [uploadedByUserCognitoId], references: [cognitoId], name: "UserProofFiles", onDelete: SetNull, map: "proof_file_uploaded_user_fkey")
  uploadedByAdmin    Admin?    @relation(fields: [uploadedByAdminCognitoId], references: [cognitoId], name: "AdminProofFiles", onDelete: SetNull, map: "proof_file_uploaded_admin_fkey")
  uploadedByAccounts Accounts? @relation(fields: [uploadedByAccountsCognitoId], references: [cognitoId], name: "AccountsProofFiles", onDelete: SetNull, map: "proof_file_uploaded_accounts_fkey")
  uploadedByStaff    Staff?    @relation(fields: [uploadedByStaffCognitoId], references: [cognitoId], name: "StaffProofFiles", onDelete: SetNull, map: "proof_file_uploaded_staff_fkey")

  transaction Transaction? @relation("TransactionProofFile")

  @@index([clientExpenseId])
  @@index([operationalExpenseId])
  @@index([quotationId])
  @@index([uploadedByUserCognitoId])
  @@index([uploadedByAdminCognitoId])
  @@index([uploadedByAccountsCognitoId])
  @@index([uploadedByStaffCognitoId])
}

model AuditLog {
