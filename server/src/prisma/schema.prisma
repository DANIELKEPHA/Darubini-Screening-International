  @@unique([stickyNoteId, staffCognitoId])
  @@unique([stickyNoteId, accountsCognitoId])
  @@index([stickyNoteId])
  @@index([adminCognitoId])
  @@index([staffCognitoId])
  @@index([accountsCognitoId])
}